# Auto-normalizar: detectar texto y guardarlo como LF en el repo.
# En el working tree cada SO recibe sus terminadores según core.autocrlf.
* text=auto eol=lf

# Código y configuración (texto, LF)
*.astro      text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.json       text eol=lf
*.jsonc      text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.md         text eol=lf
*.mdx        text eol=lf
*.txt        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.toml       text eol=lf
*.svg        text eol=lf
*.xml        text eol=lf
*.webmanifest text eol=lf

# Scripts de shell: SIEMPRE LF (si no, no ejecutan en Linux/macOS)
*.sh         text eol=lf
Dockerfile   text eol=lf
.dockerignore text eol=lf
.gitignore   text eol=lf
.npmrc       text eol=lf

# Scripts de Windows: SIEMPRE CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Binarios (no tocar)
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.avif       binary
*.ico        binary
*.pdf        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.otf        binary
*.eot        binary
*.mp4        binary
*.mp3        binary
*.webm       binary
*.zip        binary
*.gz         binary
*.docx       binary
*.xlsx       binary
bun.lockb    binary

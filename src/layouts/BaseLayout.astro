---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import { getLangFromUrl } from "../i18n/utils";

const { pathname } = Astro.url;

type Props = {
	seo?: AstroSeoProps;
};

const { seo: seoProp } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const shareImage = new URL("/images/meta/OPimg.png", Astro.site).toString();

const defaultSeo: AstroSeoProps = {
	title: "Audacetics - Audioguías digitales",
	description:
		"Audacetics delivers innovative digital audio guide solutions for tourism and cultural experiences, combining technology with storytelling",
	canonical: "https://audacetics.com",
	openGraph: {
		url: "https://audacetics.com",
		title: "Audacetics - Audioguías digitales",
		description:
			"Audacetics delivers innovative digital audio guide solutions for tourism and cultural experiences, combining technology with storytelling",
		images: [
			{
				url: shareImage,
				width: 695,
				height: 695,
				alt: "Audacetics - Digital Audio Guides",
				type: "image/png",
			},
		],
		site_name: "Audacetics",
	},
	twitter: {
		handle: "@audacetics",
		site: "@audacetics",
		cardType: "summary_large_image",
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "Audacetics",
		},
	],
};

const seo = {
	...defaultSeo,
	...seoProp,
};

function cursorFollowerActive() {
	const paths = ["", "/", "/en/", "/en"];
	return paths.includes(pathname);
}
---

<html lang={lang}>
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
	</head>
	<body class="bg-slate-50">
		<BackgroundTexture />
		<Navigation />
		{cursorFollowerActive() && <BlobCursorFollower />}
		<slot />
		<Footer />
	</body>
</html>

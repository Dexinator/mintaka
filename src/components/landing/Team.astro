---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";
import BlobAnimation from "@components/global/BlobAnimation.astro";
import GrainyGradient from "@components/global/GrainyGradient.astro";
import aspasLogo from "@assets/images/team/aspas-logo.png";
import asprodesLogo from "@assets/images/team/asprodes-logo.png";
import jorgeBadilloImg from "@assets/images/team/jorge-badillo.png";
import agustinRodriguezImg from "@assets/images/team/agustin-rodriguez.png";
import rutLomenaImg from "@assets/images/team/rut-lomena.png";
import ireneHernandezImg from "@assets/images/team/Irene.png";

const { class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const team = [
	{
		name: "Agustín Rodríguez Zúñiga",
		role: t("team.role.agustin"),
		image: agustinRodriguezImg,
	},
	{
		name: "Rut Lomeña Valbuena",
		role: t("team.role.rut"),
		image: rutLomenaImg,
	},
	{
		name: "Jorge Badillo Delgado",
		role: t("team.role.jorge"),
		image: jorgeBadilloImg,
	},
	{
		name: "Irene Hernández Martín",
		role: t("team.role.irene"),
		image: ireneHernandezImg,
	}
];

const collaborators = [
	{
		name: "ASPAS",
		logo: aspasLogo,
		url: "https://aspas-salamanca.es"
	},
	{
		name: "ASPRODES",
		logo: asprodesLogo,
		url: "https://asprodes.es/"
	}
];
---

<section id="team" class:list={["section team-section relative text-zinc-900", className]}>
	<GrainyGradient
		class="absolute inset-0 w-full h-full"
		colorBg="#f4f4f5"
		colorA="#9DD3CA"
		colorB="#EE7088"
		colorC="#474496"
	>
		<BlobAnimation />
	</GrainyGradient>
	<div class="wrapper col-span-12 py-32 relative z-10">
		<div class="mb-20 text-center">
			<h2 class="font-display text-5xl uppercase md:text-6xl lg:text-8xl text-[#474496]">{t("team.title")}</h2>
		</div>

		<div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
			{
				team.map(({ name, role, image }) => (
					<div class="team-member flex flex-col items-center text-center">
						<div class="mb-4 h-48 w-48 overflow-hidden rounded-full bg-white/80 backdrop-blur-sm shadow-lg">
							<img src={typeof image === 'string' ? image : image.src} alt={name} class="h-full w-full object-cover" />
						</div>
						<h3 class="text-xl font-bold">{name}</h3>
						<p class="text-sm text-zinc-600">{role}</p>
					</div>
				))
			}
		</div>

		<div class="mx-auto mt-20 max-w-4xl text-center">
			<h3 class="mb-10 text-3xl font-bold">{t("team.collaborates")}</h3>
			<div class="flex flex-wrap items-center justify-center gap-12">
				{
					collaborators.map(({ name, logo, url }) => (
						<a
							href={url}
							target="_blank"
							rel="noopener noreferrer"
							class="collaborator-link rounded-lg bg-white/70 backdrop-blur-sm px-12 py-10 border-2 border-transparent hover:border-[#EE7088] transition-all flex items-center justify-center hover:shadow-xl"
							aria-label={`Visitar sitio web de ${name}`}
						>
							<img src={logo.src} alt={`Logo de ${name}`} class="h-32 w-auto object-contain md:h-40" />
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.team-section {
		overflow: hidden;
		position: relative;
		isolation: isolate;
	}

	.team-member {
		transition: transform 0.3s ease;
		position: relative;
	}

	.team-member:hover {
		transform: translateY(-5px);
	}

	.team-section :global(.grainy-gradient) {
		border-radius: 0;
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { getPreferences } from "@/stores/accessibilityStore";

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const prefs = getPreferences();
		const reducedMotion = prefs.reducedMotion || window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const members = gsap.utils.toArray(".team-member") as gsap.DOMTarget[];

		// If reduced motion, show everything statically
		if (reducedMotion) {
			members.forEach((member) => {
				gsap.set(member, { opacity: 1, y: 0 });
			});
			return;
		}

		// Normal animation behavior
		members.forEach((member, i) => {
			gsap.from(member, {
				scrollTrigger: {
					trigger: member,
					start: "top bottom-=100",
					end: "center center",
					toggleActions: "play none none reverse",
				},
				opacity: 0,
				y: 50,
				duration: 0.6,
				delay: i * 0.1,
			});
		});
	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>

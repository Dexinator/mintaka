---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import BlobAnimation from "@components/global/BlobAnimation.astro";
import GrainyGradient from "@components/global/GrainyGradient.astro";

// Accessibility icons
import audiodescripcionIcon from "@assets/images/acces_icons/audiodescripcion.png";
import lecturaFacilIcon from "@assets/images/acces_icons/lectura_facil.png";
import lenguaSignosIcon from "@assets/images/acces_icons/lengua_signos.png";
import subtitulosIcon from "@assets/images/acces_icons/subtitulos.png";

const { class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const checkmarks = [
	t("aboutus.checkmark1"),
	t("aboutus.checkmark2"),
	t("aboutus.checkmark3"),
];

const values = [
	{
		title: t("aboutus.values.accessibility.title"),
		content: t("aboutus.values.accessibility.content"),
		icon: "accessibility",
	},
	{
		title: t("aboutus.values.innovation.title"),
		content: t("aboutus.values.innovation.content"),
		icon: "innovation",
	},
	{
		title: t("aboutus.values.inclusion.title"),
		content: t("aboutus.values.inclusion.content"),
		icon: "inclusion",
	},
	{
		title: t("aboutus.values.quality.title"),
		content: t("aboutus.values.quality.content"),
		icon: "quality",
	},
	{
		title: t("aboutus.values.heritage.title"),
		content: t("aboutus.values.heritage.content"),
		icon: "heritage",
	},
];

const experienceItems = [
	{
		label: t("aboutus.experience.audiodescription"),
		icon: audiodescripcionIcon,
	},
	{
		label: t("aboutus.experience.easyreading"),
		icon: lecturaFacilIcon,
	},
	{
		label: t("aboutus.experience.signlanguage"),
		icon: lenguaSignosIcon,
	},
	{
		label: t("aboutus.experience.subtitles"),
		icon: subtitulosIcon,
	},
	{
		label: t("aboutus.experience.highcontrast"),
		icon: null, // Placeholder - icon pending
	},
	{
		label: t("aboutus.experience.narration"),
		icon: null, // Placeholder - icon pending
	},
];
---

<section id="about" class:list={["section aboutus-section relative", className]}>
	<GrainyGradient
		class="absolute inset-0 w-full h-full"
		colorBg="#f4f4f5"
		colorA="#474496"
		colorB="#9DD3CA"
		colorC="#EE7088"
	>
		<BlobAnimation />
	</GrainyGradient>

	<div class="wrapper col-span-12 pt-8 pb-12 lg:pt-10 lg:pb-16 relative z-10">
		<!-- Checkmarks -->
		<div class="checkmarks-container mb-10 lg:mb-14">
			<ul class="flex flex-col gap-4 md:flex-row md:justify-center md:gap-8 lg:gap-12">
				{checkmarks.map((item) => (
					<li class="flex items-center gap-3 text-lg md:text-xl font-medium text-zinc-800">
						<span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#9DD3CA] text-white">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
							</svg>
						</span>
						{item}
					</li>
				))}
			</ul>
		</div>

		<!-- Values Section -->
		<div class="values-container mb-12 lg:mb-16">
			<h2 class="mb-8 text-center font-display text-4xl uppercase md:text-5xl lg:text-6xl text-[#474496]">
				{t("aboutus.values.title")}
			</h2>
			<div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-2">
				{values.slice(0, 4).map(({ title, content, icon }) => (
					<div class="value-card rounded-xl bg-white/80 backdrop-blur-sm p-6 shadow-sm transition-all hover:shadow-lg hover:bg-white/90 border border-zinc-200/50">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-[#474496]/10">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#474496]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold text-zinc-900">{title}</h3>
						<p class="text-zinc-600 leading-relaxed">{content}</p>
					</div>
				))}
			</div>
			<!-- 5th value centered -->
			{values[4] && (
				<div class="mx-auto mt-6 max-w-xl">
					<div class="value-card rounded-xl bg-white/80 backdrop-blur-sm p-6 shadow-sm transition-all hover:shadow-lg hover:bg-white/90 border border-zinc-200/50">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-[#474496]/10">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#474496]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold text-zinc-900">{values[4].title}</h3>
						<p class="text-zinc-600 leading-relaxed">{values[4].content}</p>
					</div>
				</div>
			)}
		</div>

		<!-- Experience Section -->
		<div class="experience-container">
			<h3 class="mb-10 text-center text-2xl font-bold text-zinc-800 md:text-3xl">
				{t("aboutus.experience.title")}
			</h3>
			<div class="mx-auto grid max-w-4xl grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6 md:gap-5">
				{experienceItems.map(({ label, icon }) => (
					<div class="experience-item flex flex-col items-center gap-3 rounded-xl bg-white/70 backdrop-blur-sm px-4 py-5 shadow-sm transition-all hover:shadow-md hover:bg-white/90 border border-zinc-200/50">
						<div class="flex h-14 w-14 items-center justify-center">
							{icon ? (
								<img src={icon.src} alt={label} class="h-12 w-12 object-contain" />
							) : (
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#EE7088]/10">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#EE7088]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								</div>
							)}
						</div>
						<span class="text-center text-sm font-medium text-zinc-700 md:text-base">{label}</span>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.aboutus-section {
		overflow: hidden;
		position: relative;
		isolation: isolate;
	}

	.aboutus-section :global(.grainy-gradient) {
		border-radius: 0;
	}

	.value-card {
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.value-card:hover {
		transform: translateY(-4px);
	}

	.experience-item {
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.experience-item:hover {
		transform: translateY(-2px);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { getPreferences } from "@/stores/accessibilityStore";

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const prefs = getPreferences();
		const reducedMotion = prefs.reducedMotion || window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const checkmarks = gsap.utils.toArray(".checkmarks-container li") as gsap.DOMTarget[];
		const valueCards = gsap.utils.toArray(".value-card") as gsap.DOMTarget[];
		const experienceItems = gsap.utils.toArray(".experience-item") as gsap.DOMTarget[];

		// If reduced motion, show everything statically
		if (reducedMotion) {
			[...checkmarks, ...valueCards, ...experienceItems].forEach((el) => {
				gsap.set(el, { opacity: 1, y: 0 });
			});
			return;
		}

		// Animate checkmarks
		checkmarks.forEach((item, i) => {
			gsap.from(item, {
				scrollTrigger: {
					trigger: item,
					start: "top bottom-=50",
					toggleActions: "play none none reverse",
				},
				opacity: 0,
				x: -30,
				duration: 0.5,
				delay: i * 0.15,
			});
		});

		// Animate value cards
		valueCards.forEach((card, i) => {
			gsap.from(card, {
				scrollTrigger: {
					trigger: card,
					start: "top bottom-=80",
					toggleActions: "play none none reverse",
				},
				opacity: 0,
				y: 40,
				duration: 0.6,
				delay: i * 0.1,
			});
		});

		// Animate experience items
		experienceItems.forEach((item, i) => {
			gsap.from(item, {
				scrollTrigger: {
					trigger: ".experience-container",
					start: "top bottom-=100",
					toggleActions: "play none none reverse",
				},
				opacity: 0,
				scale: 0.8,
				duration: 0.4,
				delay: i * 0.08,
			});
		});
	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>

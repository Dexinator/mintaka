---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { class: className } = Astro.props;

const projects = (await getCollection("projects", ({ slug }) => slug.startsWith(`${lang}/`))).sort(
	(a, b) => Number(b.data.pubDate) - Number(a.data.pubDate) || a.data.order - b.data.order,
);

// Frontmatter dates are UTC: without timeZone, the 1st would show as the previous month
function formatMonth(date: Date) {
	const month = date.toLocaleDateString(lang, { month: "long", timeZone: "UTC" });
	return `${month.charAt(0).toUpperCase()}${month.slice(1)} ${date.getUTCFullYear()}`;
}
---

<section id="projects" class:list={["section projects-section relative bg-[#474496] text-white", className]}>
	<div class="col-span-12 mx-auto w-full max-w-7xl py-24">
		<h2 class="mb-16 text-center font-display text-5xl uppercase md:text-6xl lg:text-8xl">{t("projects")}</h2>
		<ol class="grid list-none grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-6">
			{
				projects.map(({ data }, index) => (
					<li class:list={["project-card", index < 2 ? "lg:col-span-3" : "lg:col-span-2"]}>
						<article class="project-link group relative flex h-full flex-col overflow-hidden rounded-2xl bg-white text-zinc-900 shadow-lg">
							<div class="relative aspect-[4/3] overflow-hidden">
								<Image
									src={data.image.source}
									alt={data.image.alt}
									width={1200}
									height={900}
									widths={[400, 640, 900, 1200]}
									sizes="(max-width: 767px) 90vw, (max-width: 1023px) 45vw, 600px"
									format="webp"
									quality={80}
									loading="lazy"
									class="project-image h-full w-full object-cover"
								/>
								{(data.duration || data.audios) && (
									<p class="absolute right-4 top-4 flex flex-wrap justify-end gap-2 text-sm font-bold">
										{data.duration && <span class="rounded-full bg-white px-3 py-1">{data.duration} {t("projects.minutes")}</span>}
										{data.audios && <span class="rounded-full bg-white px-3 py-1">{data.audios} {t("projects.audios")}</span>}
									</p>
								)}
							</div>
							<div class="flex grow flex-col gap-3 p-6">
								<p class="flex flex-wrap justify-between gap-x-4 gap-y-1 text-sm font-semibold text-[#474496]">
									<span>{data.type}</span>
									<time datetime={data.pubDate.toISOString().slice(0, 7)}>{formatMonth(data.pubDate)}</time>
								</p>
								<h3 class="text-2xl font-bold">
									{/* ::after stretches the link over the whole card */}
									<a href={data.link} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0 focus:outline-none">
										{data.title}
										<span class="sr-only">({t("projects.newtab")})</span>
									</a>
								</h3>
								<p class="text-zinc-700">{data.description}</p>
								{data.features.length > 0 && (
									<ul class="flex list-none flex-wrap gap-2" aria-label={t("projects.features")}>
										{data.features.map((feature) => (
											<li class="rounded-full bg-secondary-100 px-3 py-1 text-sm font-semibold text-[#474496]">
												{t(`projects.feature.${feature}`)}
											</li>
										))}
									</ul>
								)}
								<p class="mt-auto pt-3 font-bold text-[#474496] group-hover:underline" aria-hidden="true">
									{t("projects.see")} →
								</p>
							</div>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.project-link:has(a:focus-visible) {
		outline: 4px solid #9dd3ca;
		outline-offset: 4px;
	}

	:global(.high-contrast) .project-link {
		border: 3px solid #000;
	}

	@media (prefers-reduced-motion: no-preference) {
		.project-image {
			transition: transform 0.4s ease;
		}

		.project-link:hover .project-image {
			transform: scale(1.03);
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { getPreferences } from "@/stores/accessibilityStore";

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const prefs = getPreferences();
		if (prefs.reducedMotion || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			return;
		}

		(gsap.utils.toArray(".project-card") as HTMLElement[]).forEach((card) => {
			gsap.from(card, {
				scrollTrigger: {
					trigger: card,
					start: "top bottom-=80",
					toggleActions: "play none none none",
				},
				opacity: 0,
				y: 50,
				duration: 0.6,
			});
		});
	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>

---
import LinkBlend from "@components/global/LinkBlend.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section id="hero" class="section hero min-h-screen">
	<div class="mx-auto flex h-full flex-col py-4 lg:py-10">
		<div class="relative flex flex-1 flex-col justify-around rounded-lg pb-10 pt-20 lg:rounded-2xl">
			<div class="flex justify-center">
				<h1 class="text-center font-display text-5xl font-extrabold uppercase sm:text-7xl md:text-8xl lg:text-9xl">
					<span class="hero-gradient-text" style="background: linear-gradient(90deg, #474496 0%, #9DD3CA 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; position: relative; z-index: 10;">{t("hero.title.main")}</span>
					<span class="rotator relative inline-flex h-20 w-full justify-center text-4xl sm:text-6xl md:text-7xl lg:text-8xl md:h-24 lg:h-32">
						<span>{t("hero.title.2")}</span><span>{t("hero.title.3")}</span><span>
							{t("hero.title.4")}
						</span><span>{t("hero.title.2")}</span>
					</span>
				</h1>
			</div>
			<div class="flex flex-col items-center gap-5 text-center lg:gap-10">
				<p class="mt-8 max-w-3xl font-mono lg:text-lg">
					{t("hero.subtitle")}
				</p>
				<p class="max-w-2xl font-mono text-base">
					{t("hero.cta")}
				</p>
				<div class="flex flex-col items-center justify-center gap-3 lg:col-start-1">
					<div class="squircle-bg rounded-lg bg-[#474496] hover:bg-[#5a54b3] transition-all" data-cursor-hover data-cursor-parallax>
						<a
							class="flex h-10 w-full max-w-52 flex-1 items-center justify-center px-4 py-2 text-xl text-white transition-all hover:text-[#9DD3CA] sm:w-auto md:font-bold lg:h-10"
							aria-label="Contact Page"
							href={translatePath("/contact/")}>
							{t("contact")}
						</a>
					</div>

					<small>
						{t("or")}
						<LinkBlend id="go-projects-button" isButton={true}>{t("hero.scroll")}</LinkBlend>
					</small>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-bottom: 0;
		position: relative;
		border-radius: inherit;
		overflow: hidden;
	}
	.hero > div {
		grid-column: 1 / span 12;
	}

	/* Hero appearance */
	.hero h1,
	.hero h2,
	.hero h3 {
		margin: 0;
	}
	.hero h1 {
		margin: 0;
		position: relative;
		overflow: hidden;
		/* Remove visibility hidden but keep low opacity initially */
		opacity: 0;
		animation: quickFadeIn 0.2s ease-out forwards;
	}

	@keyframes quickFadeIn {
		to {
			opacity: 1;
		}
	}
	.hero h1 > div {
		position: relative;
		margin: 0;
	}
	.hero :global(.split-parent) {
		overflow: hidden;
	}
	.hero :global(.split-child) {
		display: inline-block;
	}

	/* Text rotator */
	.rotator {
		z-index: 1; /* Lower z-index than gradient text */
		overflow: hidden !important; /* Clip overflowing text during animation */
		position: relative; /* Ensure z-index context */
		/* Hide initially to prevent flash */
		opacity: 0;
	}

	.rotator > span {
		position: absolute;
		z-index: 1; /* Keep rotator text below gradient text */
	}

	.rotator > span:not(:nth-child(1)) {
		opacity: 0;
	}

	/* Gradient text with maximum compatibility */
	.hero-gradient-text {
		/* Important: inline styles take precedence, but these serve as fallback */
		background: linear-gradient(90deg, #474496 0%, #9DD3CA 100%) !important;
		-webkit-background-clip: text !important;
		background-clip: text !important;
		-webkit-text-fill-color: transparent !important;
		color: transparent !important;
		display: inline-block !important;
		position: relative;
		z-index: 10; /* Higher z-index to stay above rotator */
		will-change: transform;
		/* Hide initially to prevent flash */
		opacity: 0;
		transform: translateY(20px);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";
	import { getPreferences } from "@/stores/accessibilityStore";

	gsap.registerPlugin(ScrollToPlugin);

	function init() {
		const prefs = getPreferences();
		const reducedMotion = prefs.reducedMotion || window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		// Make h1 visible
		gsap.set(".hero h1", {
			opacity: 1
		});

		// Animate gradient text smoothly from CSS initial state
		// If reduced motion, make it instant
		gsap.to(".hero-gradient-text", {
			duration: reducedMotion ? 0 : 1,
			y: 0,
			opacity: 1,
			ease: reducedMotion ? "none" : "power3.out",
			delay: reducedMotion ? 0 : 0.05
		});

		// Setup rotator initial state and make visible
		const rotator = document.querySelector(".hero .rotator");
		const words = document.querySelectorAll(".hero .rotator > span");
		if (words.length > 0) {
			// Set initial state for all words
			gsap.set(words[0], { opacity: 1, yPercent: 0 });
			for (let i = 1; i < words.length; i++) {
				gsap.set(words[i], { opacity: 0, yPercent: 100 });
			}
			// Make rotator visible with fade (instant if reduced motion)
			gsap.to(rotator, {
				opacity: 1,
				duration: reducedMotion ? 0 : 0.8,
				delay: reducedMotion ? 0 : 0.3,
				ease: reducedMotion ? "none" : "power2.out"
			});
		}

		// Setup rotator animation after initial content loads
		// Skip rotation animation if reduced motion is enabled
		if (!reducedMotion) {
			setTimeout(() => {
				if (words.length === 0) return;

				let rotatorTimeline = gsap.timeline({ repeat: -1 });
				rotatorTimeline.timeScale(0.5);

				for (let i = 0; i < words.length; i++) {
					let delay = i - 1;
					let wordTL = gsap.timeline();

					if (i !== 0) {
						// Animate in from bottom
						wordTL.to(words[i], {
							duration: 1,
							yPercent: 0,
							opacity: 1,
							ease: "power4.out"
						});
					} else {
						// First word is already visible, just needs to exit
						delay += 1;
					}

					if (i !== words.length - 1) {
						// Animate out to top
						wordTL.to(words[i], {
							duration: 1,
							yPercent: -100,
							opacity: 0,
							ease: "power4.out"
						});
					}
					rotatorTimeline.add(wordTL, delay);
				}
			}, 800); // Start rotator after initial animation
		}

		// Smooth scroll to services (instant if reduced motion)
		var goProjectsButton = document.getElementById("go-projects-button");
		goProjectsButton?.addEventListener("click", function () {
			if (reducedMotion) {
				// Instant scroll
				window.location.hash = "services";
			} else {
				// Smooth scroll
				gsap.to(window, { duration: 0.5, scrollTo: "#services" });
			}
		});
	}

	// Use requestAnimationFrame for better performance
	document.removeEventListener("DOMContentLoaded", init);

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init);
	} else {
		requestAnimationFrame(init);
	}
</script>

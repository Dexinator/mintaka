---
import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="section gap-y-16 py-20 lg:gap-y-24 lg:py-32">
	<div class="relative grid w-full grid-cols-1 gap-12 lg:grid-cols-3 lg:gap-16">
		<!-- Navigation Section -->
		<div class="flex flex-col gap-4">
			<h3 class="text-lg font-semibold uppercase tracking-wider opacity-60 lg:text-xl">Navegación</h3>
			<nav class="flex flex-col gap-3 text-base lg:text-lg">
				<a href={translatePath("/#hero")} class="transition-opacity hover:opacity-60">Inicio</a>
				<a href={translatePath("/#services")} class="transition-opacity hover:opacity-60">Servicios</a>
				<a href={translatePath("/#team")} class="transition-opacity hover:opacity-60">Equipo</a>
				<a href={translatePath("/#faq")} class="transition-opacity hover:opacity-60">FAQ</a>
				<a href={translatePath("/blog/")} class="transition-opacity hover:opacity-60">Blog</a>
				<a href={translatePath("/contact/")} class="transition-opacity hover:opacity-60">{t("contacts")}</a>
			</nav>
		</div>

		<!-- Contact Section -->
		<div class="flex flex-col gap-4">
			<h3 class="text-lg font-semibold uppercase tracking-wider opacity-60 lg:text-xl">Contacto</h3>
			<div class="flex flex-col gap-3 text-base lg:text-lg">
				<a href="mailto:info@audacetics.com" class="transition-opacity hover:opacity-60">info@audacetics.com</a>
			</div>
		</div>

		<!-- Social Section -->
		<div class="flex flex-col gap-6">
			<h3 class="text-lg font-semibold uppercase tracking-wider opacity-60 lg:text-xl">Síguenos</h3>
			<a
				href="https://www.instagram.com/audacetics/"
				target="_blank"
				rel="noopener noreferrer"
				class="group flex items-center gap-4 transition-opacity hover:opacity-60"
				aria-label="Síguenos en Instagram">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="48"
					height="48"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="transition-transform duration-300 group-hover:scale-110">
					<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
					<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
					<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
				</svg>
				<span class="text-xl lg:text-2xl">Instagram</span>
			</a>
		</div>
	</div>

	<!-- Bottom Bar -->
	<div class="relative mt-8 flex w-full items-center justify-between border-t border-current pt-8 text-sm opacity-60 lg:text-base">
		<div>© 2025 Audacetics</div>
		<button
			id="go-top-button"
			aria-label="Go to Top"
			class="fill-transparent transition-all duration-300 hover:scale-110 hover:fill-black hover:text-white"
			data-cursor-hover
			data-cursor-parallax>
			<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24">
				<g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="9"></circle><path d="m15 12l-3-3m0 0l-3 3m3-3v6"></path>
				</g>
			</svg>
		</button>
	</div>
</footer>

<style>
	footer {
		@apply relative flex w-full flex-col;
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";

	gsap.registerPlugin(ScrollToPlugin);

	function init() {
		var goTopButton = document.getElementById("go-top-button");

		if (!goTopButton) return;

		goTopButton.addEventListener("click", function () {
			gsap.to(window, { duration: 0.5, scrollTo: 0 });
		});
	}

	document.removeEventListener("DOMContentLoaded", init); // astro:page-load
	document.addEventListener("DOMContentLoaded", init); // astro:page-load
</script>

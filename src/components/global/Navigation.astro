---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, getUrlWithoutLang, useTranslations, useTranslatedPath } from "@i18n/utils";
import logoLight from "@assets/images/global/LOGOTIPO_FONDO_OSCURO.svg";
import logoDark from "@assets/images/global/LOGOTIPO_FONDO_CLARO.svg";

const isDev = import.meta.env.DEV;

const lang = getLangFromUrl(Astro.url);
const path = getUrlWithoutLang(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

let pages = [
	{
		title: "Inicio",
		url: "/",
	},
	// {
	// 	title: "Services",
	// 	url: "/services",
	// },
	//{
	//	title: "Blog",
	//	url: "/blog/",
	//},
	{
		title: t("contacts"),
		url: "/contact/",
	},
];

// if (isDev) {
// 	pages.push({
// 		title: "Overview",
// 		url: "/system/overview",
// 	});
// }

const { pathname } = Astro.url;
---

<header>
	<a href={translatePath("/")} aria-label="Home" class="logo absolute z-50 flex h-[4.5rem] items-center md:h-[5.9rem]">
		<div class="relative">
			<Image src={logoLight} alt="Audacetics Logo" class="logo-light logo-img h-16 w-auto md:h-20 transition-opacity duration-500" />
			<Image src={logoDark} alt="Audacetics Logo" class="logo-dark logo-img h-16 w-auto md:h-20 absolute inset-0 opacity-0 transition-opacity duration-500" />
		</div>
	</a>
	<div data-xdata="{ open: false }" class="navigation fixed right-0 top-0 z-50" data-xbind.class="{'w-full navbar-open': open}">
		<div class="ml-auto md:max-w-fit" data-xbind.class="{'max-w-3xl': open, 'max-w-[8rem]': !open }">
			<div class="mx-auto w-full">
				<div
					class="shadow-thick resizable nav-container squircle relative mx-auto flex w-full flex-col justify-center overflow-x-hidden backdrop-blur-xl backdrop-filter md:flex-row-reverse">
					<div class="nav-background"></div>
					<div class="flex flex-row items-center justify-end md:hidden">
						<a class="px-3 py-[0.4rem] pl-4" href={translatePath("/contact/")} aria-label="Contact Page">
							<Icon class="icon-mail text-white" name="octicon:mail-16" width="20" data-xbind.class="{'hidden': open}" />
						</a>
						<button
							data-xon.click="open = !open"
							data-xbind.style="{'padding-top': open ? '1rem' : '0.4rem'}"
							data-xbind.attr="{'aria-label': open ? 'Cerrar menú' : 'Abrir menú', 'aria-expanded': open ? 'true' : 'false'}"
							aria-label={lang === "es" ? "Abrir menú" : "Open menu"}
							aria-expanded="false"
							class="inline-flex items-center justify-center px-3 py-[0.4rem] pr-4 text-white hover:text-blue-300 focus:text-white focus:outline-none">
							<svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
								<path
									data-xbind.class="{'hidden': open, 'inline-flex': !open }"
									class="inline-flex"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M4 6h16M4 12h16M4 18h16">
								</path>
								<path
									data-xbind.class="{'hidden': !open, 'inline-flex': open }"
									class="hidden"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M6 18L18 6M6 6l12 12">
								</path>
							</svg>
						</button>
					</div>
					<nav data-xbind.class="{'flex': open, 'hidden': !open}" class="hidden flex-grow flex-col justify-center py-12 md:flex md:py-0">
						<ul
							class="flex list-none flex-col items-end justify-center gap-2 px-2 text-center text-3xl md:flex-row md:items-center md:text-base">
							{
								pages.map((page) => {
									const isActive =
										page.url === pathname ||
										page.url === pathname.replace(/^\/en|\/$/, "") ||
										(page.url === "/blog" && (pathname.startsWith("/blog") || pathname.startsWith("/en/blog")));
									return (
										<li data-cursor-hover>
											<a
												href={translatePath(page.url)}
												class={`inline-block cursor-pointer px-1 py-[0.33rem] ${isActive ? "active" : ""}`}
												aria-current={isActive ? "page" : undefined}>
												<span class="menu-item-container inline-block">
													<span class="menu-item px-4 py-1 font-semibold uppercase tracking-wide text-zinc-400 hover:text-white focus:text-white focus:shadow-none focus:outline-none">
														{page.title}
													</span>
												</span>
											</a>
										</li>
									);
								})
							}
							<li>
								<a href={translatePath(path, `${lang === "es" ? "en" : "es"}`)} class="inline-block cursor-pointer px-1 py-[0.33rem]">
									<span class="menu-item-container inline-block">
										<span
											class="menu-item px-4 py-1 font-semibold uppercase tracking-wide text-zinc-400 hover:text-white focus:text-white focus:shadow-none focus:outline-none">
											{lang === "es" ? "en" : "es"}
										</span>
									</span>
								</a>
							</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	.navigation,
	.logo {
		padding: 1rem var(--base-padding-x);
	}
	@media (min-width: 768px) {
		.navigation,
		.logo {
			padding: 2rem var(--base-padding-x);
		}
	}

	/* Nav container sin mix-blend-mode */
	.nav-container {
		transition: all 0.5s ease;
		position: relative;
		/* Sin color de fondo, será aplicado al pseudo-elemento */
		background: none;
		isolation: isolate; /* Crear nuevo contexto de apilamiento */
	}

	/* Pseudo-elemento para el fondo con mix-blend-mode */
	.nav-background {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		/* Fondo transparente con blur */
		background-color: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		/* Solo el fondo tiene mix-blend-mode */
		mix-blend-mode: difference;
		transition: all 0.5s ease;
	}

	/* En secciones oscuras, ajustar transparencia del fondo */
	.navigation.on-dark .nav-background {
		background-color: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	/* Estado colapsado */
	.navigation.collapsed .nav-background {
		background-color: rgba(255, 255, 255, 0.15);
	}

	.navigation.on-dark.collapsed .nav-background {
		background-color: rgba(255, 255, 255, 0.08);
	}

	/* Desactivar mix-blend cuando el menú móvil está abierto */
	.navigation.navbar-open .nav-background {
		mix-blend-mode: normal;
		background-color: rgba(255, 255, 255, 0.95);
	}

	.resizable:before {
		content: "|";
		position: absolute;
		left: 0.4rem;
		top: 0.36rem;
		font-size: 12px;
		line-height: 23px;
		color: #8e8e8e;
		opacity: 0;
		text-shadow: 4px 0 #8e8e8e;
		transition: all 0.5s ease;
	}
	.collapsed .resizable:before {
		opacity: 1;
	}

	/* Menu items - ahora sin inversión de colores */
	nav a .menu-item-container {
		border-radius: 0.45rem;
		transition: background-color 0.3s ease;
		position: relative;
	}

	nav a .menu-item {
		transition: color 0.3s ease;
		font-weight: 600;
		/* Colores normales ya que no hay mix-blend-mode en el contenido */
		color: #474496; /* Morado de la marca */
	}

	/* En secciones oscuras - texto blanco */
	.navigation.on-dark nav a .menu-item {
		color: #ffffff;
	}

	/* Hover states */
	nav ul:not(.collapsed) a:hover .menu-item-container {
		background: #9DD3CA; /* Verde agua */
	}

	nav ul:not(.collapsed) a:hover .menu-item {
		color: #474496; /* Morado */
	}

	/* Active states - Verde agua #9DD3CA */
	nav ul:not(.collapsed) a.active .menu-item-container {
		background: #9DD3CA; /* Verde agua como querías */
	}

	nav ul:not(.collapsed) a.active .menu-item {
		color: #474496; /* Morado sobre verde agua */
	}

	/* En secciones oscuras - mantener consistencia */
	.navigation.on-dark nav ul:not(.collapsed) a:hover .menu-item-container,
	.navigation.on-dark nav ul:not(.collapsed) a.active .menu-item-container {
		background: #9DD3CA; /* Verde agua consistente */
	}

	.navigation.on-dark nav ul:not(.collapsed) a:hover .menu-item,
	.navigation.on-dark nav ul:not(.collapsed) a.active .menu-item {
		color: #474496; /* Morado consistente */
	}

	/* Collapsed menu states */
	nav ul.collapsed a.active .menu-item,
	nav ul.collapsed a:hover .menu-item {
		color: #9DD3CA;
		mix-blend-mode: normal;
	}

	/* Mobile menu icon color */
	.navigation button {
		color: #474496; /* Morado de la marca */
		transition: color 0.3s ease;
	}

	.navigation.on-dark button {
		color: #ffffff; /* Blanco en secciones oscuras */
	}

	.navigation button:hover {
		color: #9DD3CA;
	}

	/* Mobile mail icon */
	.navigation .icon-mail {
		color: #474496; /* Morado de la marca */
		transition: color 0.3s ease;
	}

	.navigation.on-dark .icon-mail {
		color: #ffffff !important;
	}

	/* Fallback sin mix-blend-mode para navegadores que no lo soporten */
	@supports not (mix-blend-mode: difference) {
		.navigation {
			mix-blend-mode: normal;
		}

		.nav-container {
			background-color: rgba(255, 255, 255, 0.95) !important;
			border: 2px solid rgba(71, 68, 150, 0.2);
		}

		.navigation.on-dark .nav-container {
			background-color: #474496 !important;
			border: 2px solid rgba(157, 211, 202, 0.2);
		}

		nav a .menu-item {
			color: #474496;
		}

		.navigation.on-dark nav a .menu-item {
			color: #ffffff;
		}

		.navigation button,
		.navigation .icon-mail {
			color: #474496;
		}

		.navigation.on-dark button,
		.navigation.on-dark .icon-mail {
			color: white;
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

	gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger);

	function init() {
		// Logo alternation based on background color
		const logoLight = document.querySelector(".logo-light");
		const logoDark = document.querySelector(".logo-dark");
		const navigation = document.querySelector(".navigation");

		// Dark logo when Services section is visible
		ScrollTrigger.create({
			trigger: ".services-section",
			start: "top bottom",
			end: "top center",
			scrub: 0.5,
			markers: false,
			onUpdate: (self) => {
				const progress = self.progress;
				if (logoLight && logoDark) {
					logoLight.style.opacity = (1 - progress).toString();
					logoDark.style.opacity = progress.toString();
				}
			}
		});

		// Navigation color change for dark sections (Services y Tagline tienen fondo morado)
		// Cambiar colores cuando entramos a la sección de Services
		ScrollTrigger.create({
			trigger: ".services-section",
			start: "top 80px", // Justo cuando el nav está sobre la sección
			endTrigger: ".team-section",
			end: "top 80px", // Termina cuando llega a Team (fondo claro)
			toggleClass: { targets: ".navigation", className: "on-dark" },
			markers: false, // Cambiar a true para debug
			onToggle: (self) => {
				console.log("Navigation on-dark:", self.isActive);
			}
		});

		// Light logo when Team section is visible
		ScrollTrigger.create({
			trigger: ".team-section",
			start: "top center",
			end: "top top",
			scrub: 0.5,
			markers: false,
			onUpdate: (self) => {
				const progress = self.progress;
				if (logoLight && logoDark) {
					logoLight.style.opacity = progress.toString();
					logoDark.style.opacity = (1 - progress).toString();
				}
			}
		});

		let isHoveringMenu = false;
		let menuCollapsed = false;

		const pageLinksUl = document.querySelector("header .nav-container nav ul");

		if (!pageLinksUl) {
			return;
		}

		let menuCollapseTl = gsap
			.timeline({
				defaults: {
					ease: "back.inOut(1.7)",
					duration: 0.4,
				},
				paused: true,
				onStart: () => {
					pageLinksUl.classList.add("collapsed");
				},
			})
			.to("header .nav-container", { width: 180 })
			.to(
				pageLinksUl,
				{
					x: () => {
						const pathName = window.location.pathname;

						if (pathName === "/" || pathName === "/en/") {
							return "6rem";
						} else if (pathName.startsWith("/blog") || pathName.startsWith("/en/blog")) {
							return "0rem";
						}

						return "-6rem";
					},
				},
				"<",
			);

		const isTouchDevice = window.matchMedia("(hover: none)").matches;

		if (window.innerWidth >= 768 && !isTouchDevice) {
			function expandMenu() {
				menuCollapseTl.reverse();
				pageLinksUl?.classList.remove("collapsed");
				document.querySelector("header .navigation")?.classList.remove("collapsed");
				menuCollapsed = false;
			}

			function collapseMenu() {
				if (window.scrollY > 200) {
					menuCollapseTl.play();
					pageLinksUl?.classList.add("collapsed");
					document.querySelector("header .navigation")?.classList.add("collapsed");
					menuCollapsed = true;
				}
			}

			collapseMenu();

			const navContainer = document.querySelector(".nav-container") as HTMLElement;

			function mouseEnterHandler() {
				isHoveringMenu = true;
				expandMenu();
			}

			function mouseLeaveHandler() {
				isHoveringMenu = false;
				collapseMenu();
			}

			function handleScroll() {
				if (window.scrollY > 200 && !isHoveringMenu && !menuCollapsed) {
					collapseMenu();
				} else if (window.scrollY <= 200 && menuCollapsed) {
					expandMenu();
				}
			}

			navContainer?.removeEventListener("mouseenter", mouseEnterHandler);
			navContainer?.addEventListener("mouseenter", mouseEnterHandler);

			navContainer?.removeEventListener("mouseleave", mouseLeaveHandler);
			navContainer?.addEventListener("mouseleave", mouseLeaveHandler);

			window?.removeEventListener("scroll", handleScroll);
			window?.addEventListener("scroll", handleScroll);
		}
	}

	document.removeEventListener("DOMContentLoaded", init); // astro:page-load
	document.addEventListener("DOMContentLoaded", init); // astro:page-load
</script>

---
import type { AstroSeoProps } from "@astrolib/seo";
import Articles from "@components/blog/Articles.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const seo: AstroSeoProps = {
	title: "Audacetics Blog: Insights and Updates in Web Design, Web dev and SEO",
	description:
		"Explore the Audacetics Blog for the latest trends, tips, and insights in web design, web dev and SEO. Stay updated with our innovative digital solutions.",
	canonical: "https://audacetics.com/it/blog/",
	openGraph: {
		url: "https://audacetics.com/blog",
		title: "Audacetics Blog: Insights and Updates in Web Design, Web dev and SEO",
		description:
			"Stay informed with the latest in web design and SEO on the Audacetics Blog. Expert advice, tips, and industry insights await you.",
		images: [
			{
				url: "https://audacetics.com/opengraph/social-og.jpg",
				width: 1200,
				height: 630,
				alt: "Social open graph image of Audacetics Blog",
				type: "image/jpeg",
			},
			{
				url: "https://audacetics.com/opengraph/twitter-og.jpg",
				width: 4096,
				height: 4096,
				alt: "Twitter open graph image of Audacetics Blog",
				type: "image/jpeg",
			},
			{ url: "https://audacetics.com/opengraph/social-og.jpg" },
			{ url: "https://audacetics.com/opengraph/twitter-og.jpg" },
		],
		site_name: "Audacetics",
	},
	twitter: {
		handle: "@audacetics",
		site: "@audacetics",
		cardType: "summary_large_image",
	},
};
---

<BaseLayout seo={seo}>
	<Articles />
</BaseLayout>
